{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adaptive-vpn/packet-v1.0.schema.json",
  "title": "Adaptive VPN packet row v1.0 (legacy read compatibility)",
  "x-evidence-schema-version": "1.0.0",
  "type": "object",
  "required": [
    "sequence",
    "path_id",
    "sent_ns",
    "received_ns",
    "status",
    "rtt_ms",
    "datagram_bytes"
  ],
  "properties": {
    "sequence": {"type": "integer", "minimum": 0},
    "path_id": {"type": "string", "minLength": 1},
    "sent_ns": {"type": "integer", "minimum": 0},
    "received_ns": {"type": ["integer", "null"], "minimum": 0},
    "status": {"enum": ["received", "timeout"]},
    "rtt_ms": {"type": ["number", "null"], "minimum": 0},
    "datagram_bytes": {"type": "integer", "minimum": 32}
  },
  "x-bundle-policy": "evidence-bundle-policy.schema.json",
  "additionalProperties": false
}
