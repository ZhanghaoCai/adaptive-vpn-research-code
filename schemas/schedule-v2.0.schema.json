{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-vpn.invalid/schemas/schedule-v2.0.schema.json",
  "title": "Adaptive VPN frozen schedule v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_stage",
    "dataset_id",
    "design",
    "schedule_seed",
    "config_sha256",
    "expected_cells",
    "source",
    "cells"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "campaign_stage": {"enum": ["smoke", "pilot", "main"]},
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "design": {"const": "randomised-complete-block"},
    "schedule_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_cells": {"type": "integer", "minimum": 1},
    "source": {"const": "config/system_config.yaml"},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "ordinal",
        "block",
        "scenario_id",
        "traffic_profile_id",
        "strategy"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "ordinal": {"type": "integer", "minimum": 1},
        "block": {"type": "integer", "minimum": 1},
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "traffic_profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "strategy": {"enum": ["static", "threshold", "adaptive"]}
      }
    }
  }
}
